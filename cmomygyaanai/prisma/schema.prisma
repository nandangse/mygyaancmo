generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ─── PLATFORM / TENANCY ────────────────────────────────────

model Agency {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  isDefault   Boolean   @default(false)
  branding    Json?     // logo, colours, etc.
  status      String    @default("active") // active | archived
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  companies   Company[]

  @@map("agencies")
}

model Company {
  id                    String    @id @default(uuid())
  agencyId              String
  agency                Agency    @relation(fields: [agencyId], references: [id])
  name                  String
  slug                  String    @unique
  status                String    @default("active") // active | trial | locked | archived
  planId                String?
  settings              Json?     // company-level settings
  icpSentence           String?   @db.Text
  strategyStatus        String?   // draft | reviewed | signed_off
  sendingIdentityEmail  String?
  whatsappNumber        String?
  websiteUrl            String?
  platformVersion       String    @default("1.0")
  pendingVersion        String?
  lockReason            String?
  lockedAt              DateTime?
  primaryContactName    String?
  primaryContactEmail   String?
  primaryContactPhone   String?
  // ─── Data residency: each tenant has its own database (decision 4.2) ───
  region                String    @default("in")      // in | eu | us | … where this tenant's data lives
  dbUrlEnc              String?   @db.Text            // tenant DB connection string, AES-256-GCM (lib/tenant-crypto)
  dbStatus              String    @default("shared")  // shared | provisioning | ready | error
  dbProvisionedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  memberships       Membership[]
  auditLogs         AuditLog[]
  featureFlags      FeatureFlag[]
  versionAgreements VersionAgreement[]
  kbDocuments       KbDocument[]
  products          Product[]
  competitors       Competitor[]
  icpProfiles       IcpProfile[]
  personas          Persona[]
  interviews        Interview[]
  strategies        Strategy[]
  keywords          Keyword[]
  channels          Channel[]
  campaigns         Campaign[]
  posts             Post[]
  contacts          Contact[]
  accounts          Account[]
  opportunities     Opportunity[]
  orders            Order[]
  mqlHandoffs       MqlHandoff[]
  lists             List[]
  enrichmentJobs    EnrichmentJob[]
  creditLedger      CreditLedgerEntry[]
  triggers          Trigger[]
  templates         Template[]
  sequences         Sequence[]
  inboxMessages     InboxMessage[]
  gifts             Gift[]
  whatsappTemplates WhatsappTemplate[]
  emailProviders    EmailProvider[]
  pipelineStages    PipelineStage[]
  deals             Deal[]
  crmTasks          CrmTask[]
  proposals         Proposal[]
  trainings         Training[]
  debriefs          Debrief[]
  brainEntries      BrainEntry[]
  segments          Segment[]
  industries        Industry[]
  leadScoreEvents   LeadScoreEvent[]
  whatsappProviders WhatsappProvider[]
  whatsappMessages  WhatsappMessage[]
  integrationConfigs IntegrationConfig[]
  integrationRequests IntegrationRequest[]
  callLogs          CallLog[]
  emailDrafts       EmailDraft[]
  emailPersonalizations EmailPersonalization[]
  seoAudits         SeoAudit[]
  kpis              Kpi[]
  kpiMeasurements   KpiMeasurement[]
  emailCampaigns    EmailCampaign[]
  mailboxConnections MailboxConnection[]
  ruleOfOnes        RuleOfOne[]
  marketingPlan     MarketingPlan?
  apiKeys           ApiKey[]
  voiceLeads        VoiceLead[]
  workflowRuns      WorkflowRun[]
  workflowCampaigns WorkflowCampaign[]

  @@index([agencyId])
  @@index([slug])
  @@index([status])
  @@map("companies")
}

model ApiKey {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  name       String
  prefix     String
  keyHash    String    @unique
  scopes     String[]  @default(["read"])
  lastUsedAt DateTime?
  revoked    Boolean   @default(false)
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId])
  @@map("api_keys")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  phone         String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships         Membership[]
  auditLogs           AuditLog[]       @relation("AuditActor")
  versionAgreements   VersionAgreement[]
  sessions            Session[]
  authenticators      Authenticator[]
  accountsAuth        AuthAccount[]
  partnerLeads        PartnerApplication[] @relation("PartnerAssignee")

  @@map("users")
}

// NextAuth required models
model AuthAccount {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@map("authenticators")
}

model Membership {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeType           String   // platform | agency | company
  scopeId             String?  // agencyId or companyId (null for platform)
  role                String   // platform_admin | agency_manager | agency_rm | client_admin | client_manager | client_user | client_viewer
  allocatedCompanyIds String[] @default([])
  grantedBy           String?
  companyId           String?
  company             Company? @relation(fields: [companyId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([scopeType, scopeId])
  @@index([companyId])
  @@map("memberships")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actor        User     @relation("AuditActor", fields: [actorId], references: [id])
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  agencyId     String?
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FeatureFlag {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  flag      String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, flag])
  @@index([companyId])
  @@map("feature_flags")
}

model Release {
  id          String   @id @default(uuid())
  version     String   @unique
  changelog   String   @db.Text
  eligibleCompanyIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versionAgreements VersionAgreement[]

  @@map("releases")
}

model VersionAgreement {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  decision  String   // approved | declined
  decidedAt DateTime @default(now())

  @@index([companyId])
  @@index([releaseId])
  @@map("version_agreements")
}

model DemoRequest {
  id         String   @id @default(uuid())
  name       String
  company    String
  role       String?
  email      String
  phone      String?
  whatMake    String?  @db.Text
  topProblem String?  @db.Text
  status     String   @default("new") // new | contacted | qualified | converted | archived
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("demo_requests")
}

// ─── INTELLIGENCE ──────────────────────────────────────────

model KbDocument {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  type            String    // brochure | presentation | website | social | pricing | case_study | other
  title           String
  sourceUrl       String?
  storagePath     String?   // cloud_storage_path
  isPublic        Boolean   @default(false)
  mime            String?
  extractedText   String?   @db.Text
  tags            String[]  @default([])
  version         Int       @default(1)
  status          String    @default("active")
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([companyId])
  @@index([companyId, type])
  @@map("kb_documents")
}

model Product {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  category    String?
  specs       Json?
  usp         String?  @db.Text
  targetBuyer String?
  priceBand   String?
  confirmed   Boolean  @default(false)
  generatedBy String?  // ai | human
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("products")
}

model Competitor {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  segmentId   String?
  segment     Segment? @relation(fields: [segmentId], references: [id])
  name        String
  site        String?
  positioning String?  @db.Text
  wins        String?  @db.Text
  loses       String?  @db.Text
  documents   Json?    // [{title,url,filePath}]
  clients     String?  @db.Text
  products    String?  @db.Text
  facility    String?  @db.Text
  learnClientsPos   String? @db.Text
  learnClientsNeg   String? @db.Text
  learnProductsPos  String? @db.Text
  learnProductsNeg  String? @db.Text
  learnFacilityPos  String? @db.Text
  learnFacilityNeg  String? @db.Text
  confirmed   Boolean  @default(false)
  generatedBy String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([segmentId])
  @@map("competitors")
}

model IcpProfile {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  minDealSize      String?  // Q1
  typicalDealSize  String?  // Q2
  primaryBuyer     String?  // Q3
  buyerRanking     String?  // Q3 ranking
  strongVerticals  String?  // Q4
  companySize      String?  // Q5
  topRegions       String?  // Q6
  salesCycleLength String?  // Q7
  ltvVsDealSize    String?  // Q8
  antiIcp          String?  @db.Text // Q9
  icpSentence      String?  @db.Text
  version          Int      @default(1)
  confirmedBy      String?
  confirmedAt      DateTime?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
  @@map("icp_profiles")
}

model Persona {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  family        String?  // sales | operations | finance | plant | purchasing | technical
  pains         String?  @db.Text
  kpis          String?  @db.Text
  pyramidLayers String[] @default([])
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts      Contact[]
  posts         Post[]

  @@index([companyId])
  @@map("personas")
}

model Interview {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  scheduledAt  DateTime?
  conductedBy  String?
  transcriptPath String?
  status       String    @default("scheduled") // scheduled | in_progress | completed | cancelled
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  questions    InterviewQuestion[]

  @@index([companyId])
  @@map("interviews")
}

model InterviewQuestion {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question    String    @db.Text
  source      String?   // icp | kb_gap | custom
  answer      String?   @db.Text
  appliedTo   String?   // icp | kb | both
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([interviewId])
  @@map("interview_questions")
}

model Strategy {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  version    Int       @default(1)
  status     String    @default("draft") // draft | reviewed | signed_off
  signedBy   String?
  signedAt   DateTime?
  sections   Json?     // structured document sections
  generatedBy String?
  promptVersion String?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId])
  @@map("strategies")
}

model Keyword {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  keyword       String
  layer         String?  // buying | thinking | unaware
  intent        String?
  monthlyVolume Int?
  targetUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@map("keywords")
}

// ─── CHANNELS & SOCIAL ─────────────────────────────────────

model Channel {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  type        String   // smtp | api | whatsapp | linkedin | call
  config      Json?    // encrypted credentials per type
  health      Json?    // daily_cap, warmup_schedule, bounce_threshold, complaint_threshold
  status      String   @default("active")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Post[]

  @@index([companyId])
  @@index([companyId, type])
  @@map("channels")
}

model Campaign {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  theme     String?
  startsOn  DateTime?
  endsOn    DateTime?
  kpi       Json?
  status    String    @default("draft")
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  posts     Post[]
  opportunities Opportunity[]

  @@index([companyId])
  @@map("campaigns")
}

model Post {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
  channelId    String?
  channel      Channel?  @relation(fields: [channelId], references: [id])
  body         String?   @db.Text
  media        Json?
  layer        String?
  personaId    String?
  persona      Persona?  @relation(fields: [personaId], references: [id])
  topic        String?
  status       String    @default("idea") // idea | drafted | approved | scheduled | published | measured
  scheduledAt  DateTime?
  publishedAt  DateTime?
  publishedUrl String?
  approvedBy   String?
  generatedBy  String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  metrics PostMetric[]
  comments PostComment[]

  @@index([companyId])
  @@index([campaignId])
  @@map("posts")
}

model PostComment {
  id           String   @id @default(uuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName   String
  authorUrl    String?
  authorAvatar String?
  body         String   @db.Text
  linkedinId   String?  @unique
  sentiment    String?  // positive | neutral | negative
  featured     Boolean  @default(false)
  capturedAt   DateTime @default(now())

  @@index([postId])
  @@map("post_comments")
}

model PostMetric {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  capturedAt  DateTime @default(now())
  impressions Int      @default(0)
  reactions   Int      @default(0)
  comments    Int      @default(0)
  clicks      Int      @default(0)
  source      String   @default("manual") // manual | api

  @@index([postId])
  @@map("post_metrics")
}

// ─── RECORDS ───────────────────────────────────────────────

model Contact {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  name           String
  email          String?
  phone          String?
  title          String?
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id])
  personaId      String?
  persona        Persona?  @relation(fields: [personaId], references: [id])
  layer          String?
  source         String?
  icpFit         Float?
  leadScore      Int?
  leadBand       String?   // hot | warm | cool | cold
  scoreUpdatedAt DateTime?
  optInEmail     Boolean   @default(false)
  optInWhatsapp  Boolean   @default(false)
  status         String    @default("active")
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  opportunities  Opportunity[]
  mqlHandoffs    MqlHandoff[]
  deals          Deal[]
  contactIndustries ContactIndustry[]
  leadScoreEvents   LeadScoreEvent[]
  whatsappMessages  WhatsappMessage[]
  callLogs          CallLog[]
  emailPersonalizations EmailPersonalization[]

  @@index([companyId])
  @@index([accountId])
  @@map("contacts")
}

model Account {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  domain      String?
  vertical    String?
  region      String?
  sizeBand    String?
  enrichment  Json?
  icpFit      Float?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]
  deals         Deal[]

  @@index([companyId])
  @@map("accounts")
}

model Opportunity {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  accountId        String?
  account          Account?  @relation(fields: [accountId], references: [id])
  contactId        String?
  contact          Contact?  @relation(fields: [contactId], references: [id])
  value            Float?
  stage            String    @default("new")
  sourceCampaignId String?
  sourceCampaign   Campaign? @relation(fields: [sourceCampaignId], references: [id])
  ownerId          String?
  notes            String?   @db.Text
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders Order[]

  @@index([companyId])
  @@index([accountId])
  @@map("opportunities")
}

model Order {
  id            String      @id @default(uuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  value         Float?
  orderDate     DateTime?
  reference     String?
  createdBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([companyId])
  @@map("orders")
}

model MqlHandoff {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  contactId        String?
  contact          Contact?  @relation(fields: [contactId], references: [id])
  accountId        String?
  threadRef        String?
  score            Float?
  sourceCampaignId String?
  notes            String?   @db.Text
  crmDealId        String?
  createdBy        String?
  createdAt        DateTime  @default(now())

  @@index([companyId])
  @@map("mql_handoffs")
}

// ─── OUTBOUND (Phase 2 schema) ─────────────────────────────

model List {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  source    String?
  status    String   @default("active")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listContacts ListContact[]

  @@index([companyId])
  @@map("lists")
}

model ListContact {
  id        String   @id @default(uuid())
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  contactId String
  addedAt   DateTime @default(now())

  @@unique([listId, contactId])
  @@map("list_contacts")
}

model EnrichmentJob {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  provider  String?
  status    String   @default("pending")
  results   Json?
  creditsUsed Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("enrichment_jobs")
}

model CreditLedgerEntry {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  type      String   // credit | debit
  amount    Int
  reason    String?
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("credit_ledger")
}

model Trigger {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  accountId String?
  type      String    // hire | expansion | funding | trade_show
  config    Json?
  expiresAt DateTime?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
  @@map("triggers")
}

model Template {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  persona   String?
  angle     String?
  body      String   @db.Text
  variables Json?
  whyItWorks String? @db.Text
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("templates")
}

model Sequence {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  cadenceType String?  // c_level | operations | technical
  status      String   @default("draft")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       SequenceStep[]
  enrollments Enrollment[]

  @@index([companyId])
  @@map("sequences")
}

model SequenceStep {
  id          String   @id @default(uuid())
  sequenceId  String
  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepNumber  Int
  channelType String   // email | linkedin | whatsapp | call
  delayDays   Int      @default(0)
  templateId  String?
  config      Json?
  createdAt   DateTime @default(now())

  touches Touch[]

  @@index([sequenceId])
  @@map("sequence_steps")
}

model Enrollment {
  id         String   @id @default(uuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId  String
