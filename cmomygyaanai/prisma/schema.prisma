  companyName      String
  email            String
  mobile           String
  website          String?
  numCustomers     String?
  yearsInOperation String?
  numEmployees     String?
  regions          String[]
  message          String?  @db.Text
  status           String   @default("open") // open | assigned | contacted | qualified | converted | archived
  source           String   @default("partner_page")
  assignedToId     String?
  assignedTo       User?    @relation("PartnerAssignee", fields: [assignedToId], references: [id])
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("partner_applications")
}

model MailboxConnection {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  userId      String    // the tenant user who connected their mailbox
  provider    String    // gmail | outlook | imap
  emailAddress String?
  status      String    @default("pending") // pending | connected | error | disconnected
  scope       String?
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  tokenExpiry  DateTime?
  lastSyncAt   DateTime?
  contactsImported Int   @default(0)
  meta        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, userId, provider])
  @@index([companyId])
  @@map("mailbox_connections")
}

model MarketingPlan {
  id          String    @id @default(uuid())
  companyId   String    @unique
  company     Company   @relation(fields: [companyId], references: [id])
  status      String    @default("draft") // draft | active
  sections    Json?     // the 1PMP squares + BMC blocks + offer/positioning fields
  generatedBy String?   // ai | manual
  lastReviewedAt DateTime?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@map("marketing_plans")
}

model RuleOfOne {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  name        String    // label for this Rule of One, e.g. "Aviation Equipment"
  status      String    @default("draft") // draft | reviewed | completed
  currentStep Int       @default(0)
  document    Json?     // the six sections (Part A)
  review      Json?     // integrity + positioning + linkedin + changeList (Part B)
  audience    Json?     // Apollo-sourced verified people for the audience
  generatedBy String?   // ai | manual
  createdBy   String?
  updatedBy   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@map("rule_of_ones")
}

model BookSummary {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  author          String
  year            Int?
  coverUrl        String?
  summary         String   // 2-paragraph summary shown on card + detail page
  whatsUnique     String?  // what's unique about the book
  ideas           String?  // ideas worth exploring (newline-separated)
  resources       Json?    // [{ label, url }] further resources (youtube / author site)
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, order])
  @@map("book_summaries")
}

model VoiceLead {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])

  // lead details (from intake form / call)
  name          String?
  phone         String
  email         String?
  companyName   String?
  message       String?   @db.Text

  // attribution
  source        String?   // website | google_ads | meta | referral | manual | test
  campaign      String?
  keyword       String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  landingPage   String?

  // timing / SLA
  formReceivedAt DateTime @default(now())
  firstCallAt    DateTime?
  secondsToCall  Int?      // seconds between form received and first call fired
  lastAttemptAt  DateTime?
  attempts       Int       @default(0)
  nextRetryAt    DateTime?

  // call outcome
  status        String    @default("new") // new | calling | reached | unreachable | retry_scheduled | completed | failed | sandbox
  outcome       String?   // connected | no_answer | busy | voicemail | invalid | declined
  callProvider  String?   // vapi | sandbox
  providerCallId String?
  recordingUrl  String?
  transcript    String?   @db.Text
  summary       String?   @db.Text   // 5-line summary from the agent

  // extracted qualification fields
  extracted     Json?     // { orgType, equipment, quantity, timeline, budgetOrTender, decisionMakers, ... }

  // scoring
  score         Int?
  band          String?   // hot | warm | cold
  scoreReason   String?   @db.Text

  // downstream
  pushedToCrm   Boolean   @default(false)
  crmRef        String?
  alertsSent    Json?     // { hotAlert: true, fallbackToLead: false, recipients: [...] }

  attemptLog    Json?     // [{ at, outcome, provider, callId }]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, band])
  @@index([companyId, formReceivedAt])
  @@map("voice_leads")
}

// A grouping container for related workflow outputs (Phase 3 "Full Campaign" equivalent).
model WorkflowCampaign {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  goal      String?  @db.Text
  status    String   @default("active") // active | archived
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs      WorkflowRun[]

  @@index([companyId])
  @@map("workflow_campaigns")
}

// A single run of a guided workflow — produces one marketing asset.
model WorkflowRun {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  campaignId    String?
  campaign      WorkflowCampaign? @relation(fields: [campaignId], references: [id])
  workflowKey   String   // catalogue key, e.g. "offer-architect"
  workflowTitle String   // snapshot of the workflow title at run time
  name          String   // user label for this run
  status        String   @default("draft") // draft | in_progress | completed
  currentStep   Int      @default(0)
  inputs        Json?    // step answers keyed by field key
  output        String?  @db.Text // the generated asset (markdown)
  verifiedFacts Json?    // extracted [CONFIRM]/[NEEDS PROOF]/(Suggested) markers
  stressTest    String?  @db.Text // "Ask the experts" critique
  version       Int      @default(0)
  pushedTo      Json?    // record of execution-bridge pushes [{target,refId,at}]
  generatedBy   String?
  createdBy     String?
  updatedBy     String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions      WorkflowRunVersion[]

  @@index([companyId])
  @@index([campaignId])
  @@map("workflow_runs")
}

// Immutable snapshot of a run's output each time it is (re)generated — Phase 3 versioning.
model WorkflowRunVersion {
  id        String   @id @default(uuid())
  runId     String
  run       WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  version   Int
  output    String?  @db.Text
  inputs    Json?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([runId])
  @@map("workflow_run_versions")
}

model PasswordSetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_set_tokens")
}
