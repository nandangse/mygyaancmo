model Kpi {
  id             String           @id @default(uuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  key            String
  label          String
  unit           String?
  category       String?          // seo | traffic | engagement | pipeline | conversion | custom
  source         String           @default("manual") // manual | seo_audit | email | whatsapp | google_analytics | google_ads | linkedin
  isDefault      Boolean          @default(false)
  hidden         Boolean          @default(false) // soft-delete: hidden, never destroyed
  higherIsBetter Boolean          @default(true)
  sortOrder      Int              @default(0)
  createdBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  measurements   KpiMeasurement[]

  @@unique([companyId, key])
  @@index([companyId])
  @@map("kpis")
}

