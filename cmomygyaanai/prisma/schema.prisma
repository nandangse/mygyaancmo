  company   Company  @relation(fields: [companyId], references: [id])
  weekStart DateTime // Monday of the measured week (date-only semantics)
  value     Float
  note      String?
  isAuto    Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([kpiId, weekStart])
  @@index([companyId])
  @@index([kpiId])
  @@map("kpi_measurements")
