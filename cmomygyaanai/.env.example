# ============================================================================
# MyGyaan CMO Portal - Environment Configuration (TEMPLATE)
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in REAL values on your own server.
# NEVER commit the filled-in .env to git. All values below are placeholders.
# ============================================================================

# --- DATABASES (required) ----------------------------------------------------
# The REGISTRY database: agencies, companies, users, logins, roles, billing.
# Hosted in India with the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cmo_registry?schema=public"

# Every company (tenant) gets its OWN database. New tenants are created on this
# server as cmo_t_<slug> unless a different Database URL is given in /admin
# when the company is created (e.g. a Postgres server in the customer's country).
TENANT_DB_ADMIN_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Encrypts tenant connection strings stored in the registry. 32 bytes, base64:
#   openssl rand -base64 32
# Losing this key means re-provisioning every tenant's connection. Back it up.
TENANT_DB_KEY="REPLACE_WITH_openssl_rand_base64_32"

# --- AUTH (required) ---------------------------------------------------------
# Generate each secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_openssl_rand_base64_32"
AUTH_SECRET="REPLACE_WITH_openssl_rand_base64_32"
# Public URL the app is served from (used by NextAuth for callbacks).
# On your server set this to your real domain, e.g. https://cmo.yourdomain.com
NEXTAUTH_URL="https://cmo.yourdomain.com"

# --- FIRST-RUN ADMIN (used once by `yarn bootstrap`) -------------------------
# The platform admin login for /admin. Change the password after first login.
ADMIN_EMAIL="admin@mygyaan.ai"
ADMIN_PASSWORD="REPLACE_ME_min_12_chars"
ADMIN_NAME="Platform Admin"

# ============================================================================
# ABACUS.AI-PROVIDED SERVICES (optional - see INSTALL_SELF_HOST.md Section 7)
# ----------------------------------------------------------------------------
# These power AI text/image generation, file storage, email notifications,
# HTML->PDF and FFmpeg. If you keep using them, requests leave India and go to
# Abacus.AI. For FULL India residency, replace each with an India-based
# provider as described in the install guide. Leave blank to disable a feature.
# ============================================================================

# --- AI / LLM (text + image generation) --------------------------------------
# Abacus RouteLLM key. To self-host AI fully in India, point the LLM client in
# lib/ to an India-hosted model endpoint (e.g. OpenAI-compatible) instead.
ABACUSAI_API_KEY=""

# --- CLOUD FILE STORAGE (S3-compatible) --------------------------------------
# Used for Knowledge Base uploads, logos, book covers, etc.
# Point these at ANY S3-compatible bucket in an India region.
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="your-india-bucket"
AWS_FOLDER_PREFIX="mygyaan-cmo/"
# For standard AWS credentials use the two below instead of AWS_PROFILE:
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# AWS_PROFILE is only for the Abacus-managed environment; leave blank on your server.
AWS_PROFILE=""

# --- EMAIL NOTIFICATIONS (app owner alerts) ----------------------------------
# These IDs route notification emails through the Abacus notification service.
# To self-host, replace the sendNotificationEmail() helper in lib/ with your
# own SMTP / email API (e.g. Mailer Cloud, which is already integrated) and
# remove these.
WEB_APP_ID=""
NOTIF_ID_SEO_AUDIT_REPORT=""
NOTIF_ID_PROJECTION_CALCULATOR_RESULT=""
NOTIF_ID_NEW_PROJECTION_LEAD=""
NOTIF_ID_AGENCY_PARTNER_APPLICATION=""
